# ==========================================
# C/C++ Intermediate Build Artifacts
# ==========================================
# Compiled Object files (machine code)
*.obj
*.o

# Precompiled headers
*.pch
*.gch

# Linker database files and debug symbols (heavy files generated by MSVC)
*.pdb
*.ilk
*.idb

# ==========================================
# Executables and Output Binaries
# ==========================================
# The compiled executable files you run
*.exe
*.out
*.app

# Static and Dynamic Libraries
*.lib
*.a
*.dll
*.so
*.dylib

# ==========================================
# Visual Studio Code & System Rules
# ==========================================
# Ignore local user states/history folders
.history/
.VSCodeCounter/

# Whitelist your workspace setup so others can run it out-of-the-box
.vscode/*
!.vscode/tasks.json
!.vscode/c_cpp_properties.json
!.vscode/launch.json
!.vscode/extensions.json

# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini
